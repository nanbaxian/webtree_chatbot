# rag-service/.env.example
# Copy this to .env or export the variables in your shell before running npm start.

# PostgreSQL connection string for the external RAG database.
# Local server example:
# DATABASE_URL=postgresql://webtree_rag:your_password@127.0.0.1:5432/webtree_rag
# Remote server example:
# DATABASE_URL=postgresql://webtree_rag:your_password@203.0.113.10:5432/webtree_rag
DATABASE_URL=

# Optional HTTP port for the retrieval service.
PORT=8789

# Optional bearer token to protect the RAG API.
RAG_API_KEY=

# Pool sizing and SSL behavior.
PGPOOL_MAX=10
PGSSLMODE=disable

# Set to true to run the service without a database for smoke testing.
RAG_MOCK=false
