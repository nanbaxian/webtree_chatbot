# .env.local (Next.js client env)
# Browser-side Supabase auth and site URL for KnowledgeOS.

NEXT_PUBLIC_SITE_URL=https://aiassistant.webtreeedu.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set this to your production Pages domain so the frontend can generate the correct callback URLs.
# Example: https://aiassistant.webtreeedu.com
NEXT_PUBLIC_API_BASE_URL=

# Optional external RAG service for /api/chat orchestration.
# This is a server-side URL, not exposed to the browser.
# Local development example:
# RAG_API_URL=http://127.0.0.1:8789
# Production example:
# RAG_API_URL=https://rag.your-domain.com
RAG_API_URL=

# Optional bearer token for the external RAG service, only if you enabled one.
RAG_API_KEY=

# Backend worker used by Pages /api/chat.
# Local development example:
# CHAT_BACKEND_URL=http://127.0.0.1:8790
# Production example:
# CHAT_BACKEND_URL=https://webtree-chatbot-back.<your-workers-domain>
CHAT_BACKEND_URL=
