{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "ES2018",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "cf-env.d.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/supabase-browser.ts",
    "next-env.d.ts",
    "next.config.ts",
    "types/**/*.ts",
    ".next-runtime/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "functions/**",
    "workers/**"
  ]
}
