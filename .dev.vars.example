# .dev.vars - local development env vars for KnowledgeOS
# Do not commit real secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
CHAT_BACKEND_URL=http://127.0.0.1:8790
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=optional-elevenlabs-voice-id
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_JWT_ISS=https://xxxxxxxx.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
CRON_SECRET=any-random-string-you-choose

# Optional external RAG service used by /api/chat.
RAG_API_URL=
RAG_API_KEY=
RAG_REQUEST_TIMEOUT_MS=5000

# OPENAI_API_KEY belongs to webtree_chatbot_back, not the Pages frontend.
