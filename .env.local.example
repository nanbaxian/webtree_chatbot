# .env.local (Next.js client env)
# Browser-side Supabase auth and site URL for KnowledgeOS.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set this to your production Pages domain so the frontend can generate the correct callback URLs.
# Example: https://knowledgeos.pages.dev
NEXT_PUBLIC_API_BASE_URL=
